{
  "name": "geo-audit",
  "version": "0.1.0",
  "description": "Audit how AI models answer category questions and whether your brand shows up. GEO/AEO visibility scoring from the command line.",
  "type": "module",
  "bin": {
    "geo-audit": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean --dts",
    "dev": "bun src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "geo",
    "aeo",
    "ai-search",
    "llm",
    "brand-visibility",
    "seo"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ora": "^8.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
